#!/bin/bash
# Onyx XFCE — clock module for genmon: "Oct 26 · 4:27 P".
# Click opens the calendar popup. Only bash builtins: no extra processes.
# shellcheck source=bin/onyx-common.sh
. "${0%/*}/onyx-common.sh"

printf -v long '%(%A, %-d %B %Y)T' -1      # tooltip, in the user's locale
export LC_ALL=${ONYX_CLOCK_LOCALE:-C}
printf -v now '%(%b %-d|%-I:%M|%H)T' -1
IFS='|' read -r day hm h24 <<<"$now"
(( 10#$h24 < 12 )) && ap=A || ap=P

click="${ONYX_BIN}/onyx-popup calendar"
printf '<txt>%s · %s %s</txt><txtclick>%s</txtclick><tool>%s</tool>' \
    "$day" "$hm" "$ap" "$click" "$long"
