#!/usr/bin/env python3
"""Onyx XFCE — small popups opened from the panel modules.

    onyx-popup calendar
    onyx-popup wifi <plugin-id>
    onyx-popup bluetooth <plugin-id>
    onyx-popup brightness <plugin-id> <backlight-device>

Each click starts one short-lived process that exits when the popup closes
(Esc, click outside, or clicking the same module again). Uses only
PyGObject/GTK 3 and D-Bus (NetworkManager, BlueZ, logind), already present
on Linux Mint XFCE.
"""
import os
import subprocess
import sys
import time

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, Gio, GLib, Gtk  # noqa: E402

RUN = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/dev/shm"), "onyx-xfce")
PIDFILE = os.path.join(RUN, "popup.pid")
CLOSEDFILE = os.path.join(RUN, "popup.closed")

CSS = b"""
window.onyx { background-color: #101010; color: #eeeeee; border: 1px solid #252525;
              font-family: "DejaVu Sans Mono"; font-size: 9pt; }
window.onyx * { font-family: "DejaVu Sans Mono"; }
.onyx-title { font-weight: bold; color: #eeeeee; }
.onyx-dim { color: #8c8c8c; }
.onyx-sep { background-color: #252525; min-height: 1px; margin: 4px 0; }
window.onyx button { background: none; border: none; box-shadow: none; border-radius: 3px;
                     padding: 4px 8px; color: #eeeeee; text-shadow: none; -gtk-icon-shadow: none; }
window.onyx button:hover { background-color: #252525; }
window.onyx button.onyx-active label { color: #f0f0f0; font-weight: bold; }
window.onyx button.onyx-primary { background-color: #f0f0f0; }
window.onyx button.onyx-primary label { color: #101010; font-weight: bold; }
window.onyx entry { background-color: #252525; color: #eeeeee; border: 1px solid #252525;
                    border-radius: 3px; box-shadow: none; caret-color: #f0f0f0; }
